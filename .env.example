# Copy to ~/.claude/telegram-notify.env (or set the same variables in the environment).
# Token: create a bot with @BotFather. Chat id: write to the bot, then open
# https://api.telegram.org/bot<TOKEN>/getUpdates and read message.chat.id.
TELEGRAM_NOTIFY_TOKEN=123456789:replace-with-your-bot-token
TELEGRAM_NOTIFY_CHAT_ID=123456789
